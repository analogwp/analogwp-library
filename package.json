{
  "name": "analog-library",
  "version": "2.1.0",
  "description": "Handfully crafted Elementor templates packs.",
  "main": "/client/index.js",
  "private": true,
  "scripts": {
    "install-scripts": "composer install && npm install",
    "build": "wp-scripts build --webpack-src-dir=client --output-path=assets/js/app",
    "dev": "wp-scripts start --webpack-src-dir=client --output-path=js/app",
    "makePot": "wp i18n make-pot . ./languages/analog-library.pot",
    "convertPot2json": "npx po2json ./languages/analog-library.pot ./languages/analog-library-analogwp-app.json -f jed1.x",
    "plugin-zip": "npm run build && wp-scripts plugin-zip",
    "translate": "gulp translate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analogwp/analogwp-templates.git"
  },
  "author": "Krishna and John",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/analogwp/analogwp-templates/issues"
  },
  "homepage": "https://github.com/analogwp/analogwp-templates#readme",
  "dependencies": {
    "classnames": "^2.2.6",
    "react-masonry-css": "^1.0.14",
    "react-select": "^5.8.2",
    "react-waypoint": "^10.3.0",
    "regenerator-runtime": "^0.14.1",
    "styled-components": "^4.1.3"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.4.0",
    "gulp": "^5.0.0",
    "gulp-checktextdomain": "^2.3.0",
    "gulp-run-command": "^0.0.10"
  },
  "files": [
    "assets",
    "inc",
    "languages",
    "third-party",
    "analog-library.php",
    "uninstall.php",
    "readme.txt"
  ]
}
